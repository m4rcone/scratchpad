{
  "name": "scratchpad",
  "version": "1.2.0",
  "private": true,
  "description": "A markdown scratchpad on the Chrome toolbar (MV3). No account, no network, data stays on your machine.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "markdown",
    "scratchpad",
    "notes",
    "offline",
    "bytemd"
  ],
  "homepage": "https://github.com/m4rcone/scratchpad-newtab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4rcone/scratchpad-newtab.git"
  },
  "bugs": {
    "url": "https://github.com/m4rcone/scratchpad-newtab/issues"
  },
  "author": "Marcone Boff (https://github.com/m4rcone)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && rm -f scratchpad.zip && cd dist && zip -qr ../scratchpad.zip . -x '*.map'",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.8",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@bytemd/plugin-breaks": "^1.22.0",
    "@bytemd/plugin-gemoji": "^1.22.0",
    "@bytemd/plugin-gfm": "^1.22.0",
    "@bytemd/plugin-highlight-ssr": "^1.22.0",
    "@bytemd/plugin-math": "^1.22.0",
    "@bytemd/plugin-mermaid": "^1.22.0",
    "bytemd": "^1.22.0"
  }
}
